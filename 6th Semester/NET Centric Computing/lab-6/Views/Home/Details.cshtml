@model lab_6.Models.Student

@{
    ViewData["Title"] = "Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Details</h1>
    <div class="d-flex gap-2">
        @* Edit Button *@
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>

        @* Delete Button *@
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </form>
    </div>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Id
        </dt>
        <dd class = "col-sm-10">
            @Model?.Id
        </dd>

        <dt class = "col-sm-2">
            Name
        </dt>
        <dd class = "col-sm-10">
            @Model?.Name
        </dd>

        <dt class = "col-sm-2">
            Email
        </dt>
        <dd class = "col-sm-10">
            @Model?.Email
        </dd>

        <dt class = "col-sm-2">
            Created At
        </dt>
        <dd class = "col-sm-10">
            @Model?.CreatedAt
        </dd>
    </dl>
</div>

