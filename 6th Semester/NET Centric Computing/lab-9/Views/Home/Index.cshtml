@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1>Cookie Login</h1>
    <p>Login information is stored in a persistent cookie for five days.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary">Open dashboard</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
    }
</div>
