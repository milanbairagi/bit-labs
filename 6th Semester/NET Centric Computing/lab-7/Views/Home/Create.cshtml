@model lab_7.Models.Player

@{
    ViewData["Title"] = "Create";
}

<h1>Add new player</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Name" placeholder="Name" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <br />

    <input asp-for="Age" placeholder="Age" />
    <span asp-validation-for="Age" class="text-danger"></span>
    <br />

    <input asp-for="Email" placeholder="Email" />
    <span asp-validation-for="Email" class="text-danger"></span>
    <br />

    <input asp-for="Team" placeholder="Team" />
    <span asp-validation-for="Team" class="text-danger"></span>
    <br />

    <input asp-for="JoinedDate" placeholder="Joined Date" />
    <span asp-validation-for="JoinedDate" class="text-danger"></span>
    <br />

    <input type="submit" class="btn btn-primary" value="Create" />
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}