@model IEnumerable<lab_7.Models.Player>

@{
    ViewData["Title"] = "Home";
}

<h1>Player List</h1>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Email</th>
            <th>Team</th>
            <th>Joined Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.Id</td>
                <td>@player.Name</td>
                <td>@player.Age</td>
                <td>@player.Email</td>
                <td>@player.Team</td>
                <td>@player.JoinedDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>